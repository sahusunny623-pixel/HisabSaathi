PORT=3000
DATABASE_FILE=./data/hisabsaathi.db
CORS_ORIGIN=http://localhost:3000

# Supabase public client configuration. Use Replit Secrets for deployed values.
SUPABASE_URL=
SUPABASE_ANON_KEY=

PAYMENT_PROVIDER=upi_manual
UPI_PAYMENT_ID=
UPI_QR_URL=

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
ADMIN_WHATSAPP_TO=
# Use template for business-initiated notifications; use text only when a valid WhatsApp conversation window exists.
WHATSAPP_MESSAGE_MODE=template
WHATSAPP_TEMPLATE_NAME=hisabsaathi_payment_claim
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_SEND_PROOF_IMAGE=true

SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
WORKER_INTERVAL_MS=60000
ADMIN_VERIFY_SECRET=
ADMIN_NOTIFICATION_WEBHOOK_URL=
ADMIN_NOTIFICATION_SECRET=
UPI_WEBHOOK_SECRET=
PAYMENT_UPLOAD_DIR=./data/payment-proof
